{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "definitions": {
    "extraContainer": {
      "type": "object",
      "required": ["image"],
      "properties": {
        "image": { "type": "string", "pattern": "^.+@sha256:[a-f0-9]{64}$" },
        "azureIdentity": { "type": "boolean" }
      }
    }
  },
  "properties": {
    "namespace": { "type": "string" },
    "platform": {
      "type": "object",
      "properties": {
        "syncWaves": {
          "type": "object",
          "properties": {
            "namespace": { "type": "integer" },
            "deployment": { "type": "integer" },
            "service": { "type": "integer" },
            "rollout": { "type": "integer" },
            "listenerSet": { "type": "integer" },
            "httpRoute": { "type": "integer" },
            "serviceAccount": { "type": "integer" },
            "userAssignedIdentity": { "type": "integer" },
            "federatedIdentityCredential": { "type": "integer" },
            "roleAssignment": { "type": "integer" },
            "storageContainer": { "type": "integer" }
          },
          "additionalProperties": false
        },
        "azure": {
          "type": "object",
          "properties": {
            "identities": {
              "type": "object",
              "propertyNames": { "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63 },
              "additionalProperties": {
                "type": "object",
                "required": ["azureName"],
                "properties": {
                  "azureName": { "type": "string", "minLength": 1 },
                  "create": { "type": "boolean" },
                  "resourceGroup": { "type": "string", "minLength": 1 },
                  "clientId": { "type": "string", "minLength": 1 }

                }
              }
            },
            "roleAssignments": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "identity",
                  "roleName",
                  "scope"
                ],
                "properties": {
                  "identity": {
                    "type": "string",
                    "minLength": 1
                  },
                  "roleName": {
                    "type": "string",
                    "minLength": 1
                  },
                  "scope": {
                    "enum": [
                      "keyVault",
                      "storageAccount"
                    ]
                  }
                },
                "additionalProperties": false
              }
            },
            "storageContainers": {
              "type": "object",
              "propertyNames": { "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63 },
              "additionalProperties": {
                "type": "object",
                "required": ["azureName"],
                "properties": {
                  "azureName": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{1,61}[a-z0-9])$" }
                }
              }
            }
          }
        }
      }
    },
    "hosts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["hostname"],
        "properties": {
          "hostname": { "type": "string", "minLength": 1, "pattern": "^[^*]+$" }
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["image", "port", "healthPath"],
        "properties": {
          "delivery": { "enum": ["deployment", "rollout"] },
          "image": {
            "type": "string",
            "pattern": "^.+@sha256:[a-f0-9]{64}$"
          },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "healthPath": { "type": "string", "pattern": "^/" },
          "replicas": { "type": "integer", "minimum": 1 },
          "resources": { "type": "object" },
          "identity": { "type": "string", "minLength": 1 },
          "sidecars": {
            "type": "object",
            "additionalProperties": { "$ref": "#/definitions/extraContainer" }
          },
          "initContainers": {
            "type": "object",
            "additionalProperties": { "$ref": "#/definitions/extraContainer" }
          },
          "route": {
            "type": "object",
            "required": ["host", "path"],
            "properties": {
              "host": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "pattern": "^/" }
            }
          }
        }
      }
    }
  }
}
