{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "definitions": {
    "credentialMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "minLength": 1},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}},
        "labels": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "credentialSpec": {
      "type": "object",
      "required": ["spec"],
      "additionalProperties": false,
      "properties": {
        "metadata": {"$ref": "#/definitions/credentialMetadata"},
        "spec": {"type": "object"}
      }
    },
    "extraContainer": {
      "type": "object",
      "required": ["image"],
      "properties": {
        "image": { "type": "string", "pattern": "^.+@sha256:[a-f0-9]{64}$" },
        "azureIdentity": { "type": "boolean" }
      }
    }
  },
  "properties": {
    "name": {"type": "string", "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63},
    "hostname": {"type": "string", "pattern": "^[^*]*$"},
    "databases": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]*$", "maxLength": 63},
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 63},
          "reclaimPolicy": {"enum": ["retain", "delete"]},
          "migration": {
            "type": "object", "required": ["repository", "tag"], "additionalProperties": false,
            "properties": {
              "repository": {"type": "string", "minLength": 1},
              "tag": {"type": "string", "minLength": 1, "not": {"enum": ["latest"]}}
            }
          }
        }
      }
    },
    "namespace": { "type": "string" },
    "platform": {
      "type": "object",
      "properties": {
        "tests": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "playwright": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "enabled": {"type": "boolean"},
                "path": {"type": "string", "pattern": "^[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*$"},
                "image": {"type": "string", "pattern": "^.+@sha256:[a-f0-9]{64}$"},
                "timeoutSeconds": {"type": "integer", "minimum": 60, "maximum": 3600}
              }
            }
          }
        },
        "release": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "expectedRevision": {"type": "string", "pattern": "^$|^[a-f0-9]{40}$"},
            "check": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "enabled": {"type": "boolean"},
                "repository": {"type": "string", "pattern": "^$|^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
                "workflow": {"type": "string", "pattern": "^\\.github/workflows/[^/@]+\\.ya?ml$"},
                "pullRequest": {"type": "string", "pattern": "^$|^[1-9][0-9]{0,9}$"},
                "environment": {"type": "string", "pattern": "^$|^[a-z][a-z0-9-]{0,20}$"},
                "tokenSecret": {"type": "string", "minLength": 1},
                "image": {"type": "string", "pattern": "^.+@sha256:[a-f0-9]{64}$"},
                "timeoutSeconds": {"type": "integer", "minimum": 30, "maximum": 300}
              }
            }
          }
        },
        "gateway": {
          "type": "object",
          "properties": {
            "sharedListener": {
              "type": "string", "maxLength": 63,
              "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            }
          }
        },
        "lifecycle": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "cleanup": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "enabled": {"type": "boolean"},
                "image": {"type": "string", "pattern": "^.+@sha256:[a-f0-9]{64}$"},
                "timeoutSeconds": {"type": "integer", "minimum": 60, "maximum": 3600}
              }
            }
          }
        },
        "argocd": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "revision": {"type": "string", "pattern": "^$|^[a-f0-9]{40}$"},
            "chartRevision": {"type": "string", "pattern": "^$|^[a-f0-9]{40}$"},
            "previews": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "enabled": {"type": "boolean"},
                "registry": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$"},
                "domain": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$"},
                "sharedListener": {"type": "string", "minLength": 1},
                "workflow": {"type": "string", "pattern": "^\\.github/workflows/[^/@]+\\.ya?ml$"},
                "tokenSecret": {"type": "string", "minLength": 1}
              }
            },
            "environments": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "enabled": {"type": "boolean"},
                "registry": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$"},
                "targets": {
                  "type": "object",
                  "propertyNames": {"pattern": "^[a-z][a-z0-9-]{0,20}$"},
                  "additionalProperties": {
                    "type": "object", "required": ["hostname"], "additionalProperties": false,
                    "properties": {
                      "hostname": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$"},
                      "from": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,20}$"}
                    }
                  }
                }
              }
            }
          }
        },
        "kargo": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "github": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "appId": {"type": "string"},
                "installationId": {"type": "string"},
                "privateKeyRemoteKey": {"type": "string"}
              }
            },
            "verification": {
              "type": "object", "additionalProperties": false,
              "properties": {"image": {"type": "string", "pattern": "^.+@sha256:[a-f0-9]{64}$"}}
            }
          }
        },
        "credentials": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "passwords": {"type": "object", "additionalProperties": {"$ref": "#/definitions/credentialSpec"}},
            "certificates": {"type": "object", "additionalProperties": {"$ref": "#/definitions/credentialSpec"}},
            "externalSecrets": {"type": "object", "additionalProperties": {"$ref": "#/definitions/credentialSpec"}},
            "secretStores": {"type": "object", "additionalProperties": {"$ref": "#/definitions/credentialSpec"}},
            "serviceAccounts": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "metadata": {"$ref": "#/definitions/credentialMetadata"},
                  "automountServiceAccountToken": {"type": "boolean"},
                  "imagePullSecrets": {"type": "array", "items": {"type": "object"}},
                  "secrets": {"type": "array", "items": {"type": "object"}}
                }
              }
            },
            "roles": {
              "type": "object",
              "additionalProperties": {
                "type": "object", "required": ["rules"], "additionalProperties": false,
                "properties": {
                  "metadata": {"$ref": "#/definitions/credentialMetadata"},
                  "rules": {"type": "array", "items": {"type": "object"}}
                }
              }
            },
            "roleBindings": {
              "type": "object",
              "additionalProperties": {
                "type": "object", "required": ["roleRef", "subjects"], "additionalProperties": false,
                "properties": {
                  "metadata": {"$ref": "#/definitions/credentialMetadata"},
                  "roleRef": {"type": "object"},
                  "subjects": {"type": "array", "items": {"type": "object"}}
                }
              }
            }
          }
        },
        "rollout": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "progressDeadlineSeconds": {"type": "integer", "minimum": 30, "maximum": 3600},
            "progressDeadlineAbort": {"type": "boolean"},
            "maxSurge": {"type": "integer", "minimum": 0},
            "maxUnavailable": {"type": "integer", "minimum": 0},
            "initialStableWeight": {"type": "integer", "minimum": 0, "maximum": 100},
            "initialCanaryWeight": {"type": "integer", "minimum": 0, "maximum": 100},
            "canaryWeight": {"type": "integer", "minimum": 1, "maximum": 99},
            "analysis": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "image": {"type": "string", "pattern": "^.+@sha256:[a-f0-9]{64}$"},
                "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 3600}
              }
            },
            "steps": {"type": "array", "items": {"type": "object"}}
          }
        },
        "syncWaves": {
          "type": "object",
          "properties": {
            "namespace": { "type": "integer" },
            "deployment": { "type": "integer" },
            "service": { "type": "integer" },
            "rollout": { "type": "integer" },
            "listenerSet": { "type": "integer" },
            "httpRoute": { "type": "integer" },
            "serviceAccount": { "type": "integer" },
            "userAssignedIdentity": { "type": "integer" },
            "federatedIdentityCredential": { "type": "integer" },
            "roleAssignment": { "type": "integer" },
            "storageContainer": { "type": "integer" },
            "database": { "type": "integer" },
            "atlasSchema": { "type": "integer" },
            "atlasMigration": { "type": "integer" },
            "atlasAccess": { "type": "integer" }
          },
          "additionalProperties": false
        },
        "atlas": {
          "type": "object",
          "properties": {
            "roleScope": { "type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 63} },
            "roleReview": { "enum": ["ERROR", "WARNING", "ALWAYS"] },
            "blockDestructiveRoles": { "type": "boolean" },
            "azureAdminUser": {"type": "string"}
          }
        },
        "postgres": {
          "type": "object",
          "properties": {
            "backend": {"enum": ["cnpg", "azure"]},
            "azure": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "serverName": {"type": "string"},
                "serverResourceGroup": {"type": "string"},
                "caBundlePath": {"type": "string", "minLength": 1}
              }
            },
            "databaseReclaimPolicy": { "enum": ["retain", "delete"] }
          }
        },
        "azure": {
          "type": "object",
          "properties": {
            "identities": {
              "type": "object",
              "propertyNames": { "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63 },
              "additionalProperties": {
                "type": "object",
                "required": ["azureName"],
                "properties": {
                  "azureName": { "type": "string", "minLength": 1 },
                  "create": { "type": "boolean" },
                  "resourceGroup": { "type": "string", "minLength": 1 },
                  "clientId": { "type": "string", "minLength": 1 },
                  "reflectToApplication": {"type": "boolean"}

                }
              }
            },
            "roleAssignments": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "identity",
                  "roleName",
                  "scope"
                ],
                "properties": {
                  "identity": {
                    "type": "string",
                    "minLength": 1
                  },
                  "roleName": {
                    "type": "string",
                    "minLength": 1
                  },
                  "scope": {
                    "enum": [
                      "keyVault",
                      "storageAccount"
                    ]
                  }
                },
                "additionalProperties": false
              }
            },
            "storageContainers": {
              "type": "object",
              "propertyNames": { "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63 },
              "additionalProperties": {
                "type": "object",
                "required": ["azureName"],
                "properties": {
                  "azureName": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{1,61}[a-z0-9])$" }
                }
              }
            }
          }
        }
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "databases": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "maxLength": 63
              },
              "owner": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "maxLength": 63
              },
              "reclaimPolicy": {
                "enum": [
                  "retain",
                  "delete"
                ]
              }
            },
            "required": ["name"]
          }
        },
        "roles": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "login": {
                "type": "boolean"
              },
              "authentication": {"enum": ["password", "certificate", "entra"]},
              "passwordSecret": {
                "type": "string",
                "minLength": 1
              },
              "memberOf": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$",
                  "maxLength": 63
                },
                "uniqueItems": true
              }
            }
          },
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 63
          }
        },
        "migrations": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "database": {
                "type": "string",
                "minLength": 1
              },
              "role": { "type": "string", "minLength": 1 },
              "principalIdConfigMap": {"type": "string", "minLength": 1},
              "devURLSecret": { "type": "string", "minLength": 1 },
              "schema": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "maxLength": 63
              },
              "revisionsSchema": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "maxLength": 63
              },
              "syncWave": {
                "type": "integer"
              },
              "local": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": {
                  "pattern": "^[0-9]+_[a-zA-Z0-9_-]+\\.sql$"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "roleVars": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
                },
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$",
                  "maxLength": 63
                }
              },
              "repository": {
                "type": "string",
                "minLength": 1
              },
              "tag": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "enum": [
                    "latest"
                  ]
                }
              }
            },
            "required": ["database", "role"],
            "oneOf": [
              {
                "required": ["repository", "tag"],
                "not": { "anyOf": [{ "required": ["local"] }, { "required": ["roleVars"] }] }
              },
              {
                "required": ["local", "revisionsSchema"],
                "not": { "anyOf": [{ "required": ["repository"] }, { "required": ["tag"] }] }
              }
            ]
          }
        }
      }
    },
    "hosts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["hostname"],
        "properties": {
          "hostname": { "type": "string", "minLength": 1, "pattern": "^[^*]+$" }
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["image", "port"],
        "properties": {
          "delivery": { "enum": ["deployment", "rollout"] },
          "image": {
            "type": "string",
            "pattern": "^.+@sha256:[a-f0-9]{64}$"
          },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "healthPath": { "type": "string", "pattern": "^/" },
          "readinessPath": {"type": "string", "pattern": "^/"},
          "database": {"type": "string", "minLength": 1},
          "databaseEnv": {"type": "string", "minLength": 1},
          "env": {
            "type": "array",
            "items": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1 } } }
          },
          "readinessProbe": { "type": "object" },
          "replicas": { "type": "integer", "minimum": 1 },
          "resources": { "type": "object" },
          "identity": { "type": "string", "minLength": 1 },
          "sidecars": {
            "type": "object",
            "additionalProperties": { "$ref": "#/definitions/extraContainer" }
          },
          "initContainers": {
            "type": "object",
            "additionalProperties": { "$ref": "#/definitions/extraContainer" }
          },
          "route": {
            "type": "object",
            "required": ["host", "path"],
            "properties": {
              "host": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "pattern": "^/" }
            }
          }
        }
      }
    }
  }
}
